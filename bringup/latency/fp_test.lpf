LOCATE COMP "cmp[1]" SITE "N1"; IOBUF PORT "cmp[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "cmp[2]" SITE "P1"; IOBUF PORT "cmp[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "cmp[3]" SITE "J2"; IOBUF PORT "cmp[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "cmp[4]" SITE "M2"; IOBUF PORT "cmp[4]" IO_TYPE=LVCMOS33;
LOCATE COMP "tx[0]" SITE "R1"; IOBUF PORT "tx[0]" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
LOCATE COMP "tx[1]" SITE "R3"; IOBUF PORT "tx[1]" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
LOCATE COMP "tx[2]" SITE "P3"; IOBUF PORT "tx[2]" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
