LOCATE COMP "sysclk" SITE "M1"; IOBUF PORT "sysclk" IO_TYPE=LVCMOS33; FREQUENCY PORT "sysclk" 50 MHZ;
LOCATE COMP "cdi" SITE "T2"; IOBUF PORT "cdi" IO_TYPE=LVCMOS33;
LOCATE COMP "ce" SITE "R2"; IOBUF PORT "ce" IO_TYPE=LVCMOS33;
