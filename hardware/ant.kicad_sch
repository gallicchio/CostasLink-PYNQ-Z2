		(pin "1" (uuid "3fcca982-9347-2061-5ca1-755d6ad47b95"))
		(instances (project "CostasLink-PYNQ-Z2" (path "/24723b42-5fe3-4667-eb46-0acbb937e3f8/b9479df7-906a-9090-5596-bc60e4422e88" (reference "#PWR") (unit 1)))))
	(text_box "Fit this block to work with ONE antenna per direction: cable TX ANT -> SW TX and SW RX -> RX ANT (two short SMA leads, 1\nns), the antenna on ANT, and let the FPGA drive TR_A / TR_B (B = not A): A HIGH, B low = receive (ANT to RF2 = SW RX); A\nlow, B high = transmit (ANT to RF1 = SW TX).  The far end then sees our carrier only while we transmit, so its Costas\nloop HOLDs meanwhile (LOOP_HOLD) and our reply carrier must already be at its frequency: feed this board's TX\nsynthesizer from the receiver's VCXO (REF OUT -> REF IN, JP201 to REF IN) and the two carriers are coherent (a\ntransponder).  Without this block, two antennas and two frequencies: both carriers always on, no holds, no turnaround.\nsim/budget.py section 2b has the numbers." (exclude_from_sim no) (at 20.3200 24.1300 0) (size 109.2200 15.2400)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "9ba1cfc7-badb-a4ec-5cb8-5c684ed19a32"))
	(text_box "ANT, the antenna: 5.8 GHz\n(5.15-5.875 usable) | out:\n+9.1 dBm (TX less 0.7 dB)\n| in: whatever arrives,\nless 0.7 dB | ABS MAX +29\ndBm at the switch (the LNA\nbehind SW RX: +1)" (exclude_from_sim no) (at 77.4700 73.6600 0) (size 26.6700 15.2400)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 214 236 255 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "f5889af3-8164-1f28-6e91-130974696ac8"))
	(text_box "SW TX: from TX ANT (+9.8 dBm)\nor a PA (<= +29 dBm) | 27 dB\nto SW RX: -17.2 dBm leaks into\nthe receiver while\ntransmitting (0 dBm with a +27\ndBm PA: then a limiter)" (exclude_from_sim no) (at 233.6800 69.8500 0) (size 30.4800 12.7000)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 214 236 255 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "8711ba20-590a-d326-286e-84febff5804f"))
	(text_box "SW RX: to RX ANT or the LNA |\nthe rest state (A high, B low)" (exclude_from_sim no) (at 233.6800 123.1900 0) (size 29.2100 6.3500)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 214 236 255 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "0414d5a2-6143-3e56-4d9f-f39af8d99b07"))
	(text_box "J303: TR_A, TR_B and ground\nfor an external switch module\n(B made here by U402)." (exclude_from_sim no) (at 41.9100 175.2600 0) (size 27.9400 7.6200)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "362e5b09-bf96-efd3-01fe-f748e928f3d2"))
	(text_box "TR_A / TR_B: 0 / 3.3 V from the FPGA |\n30 ns edge-to-RF, 15 ns rise" (exclude_from_sim no) (at 80.0100 140.9700 0) (size 38.1000 6.3500)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 214 236 255 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "d2278df0-55f5-787f-05a6-78a6bd9a51bc"))
	(text_box "TR_A / TR_B: 0 / 3.3 V; A from the FPGA (header 27, also\nJ303), B = not A from U402 (since Response 14).  Truth table\n(datasheet): A low, B high: ANT-RF1 = SW TX (transmit).  A\nhigh, B low: ANT-RF2 = SW RX (receive): A's pull-ups (10 k\nhere, 2k2 on the PYNQ) hold A high until the gateware drives\nit, so B rests low and the switch rests in receive on both\nhosts.  30 ns from the edge to the RF settled; 15 ns rise;\nU402 adds about 3 ns to B." (exclude_from_sim no) (at 77.4700 170.1800 0) (size 55.8800 16.5100)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "62bbb644-58ff-9302-6dd9-c31a8dafc77a"))
	(text_box "HMC536MS8G: DC-6 GHz GaAs T/R\nswitch, 0.7 dB, 27 dB isolation at\n5-6 GHz, +29 dBm for 0.1 dB\ncompression, no supply pin (the\ncontrols power it).  DC blocks on\nall three RF pins (its datasheet).\nExposed pad to ground." (exclude_from_sim no) (at 132.0800 137.1600 0) (size 31.7500 15.2400)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "3a25bf44-8eee-5c30-c29e-ee1007370bb9"))
