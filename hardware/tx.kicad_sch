	(text_box "ADL5611: +14.3 dB at 5.8 GHz\n-> +9.8 dBm at the SMA.\nP1dB +12.8 dBm at 5.8 GHz\n(its 5800 MHz row): the QPSK\ncorners, 3 dB over the axis\npoints, reach it." (exclude_from_sim no) (at 276.8600 114.3000 0) (size 29.2100 12.7000)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
