	(text_box "TX_DIS high mutes the\noutput in 100 ns (200 ns\nto restore)." (exclude_from_sim no) (at 195.5800 133.3500 0) (size 24.1300 7.6200)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "1321d7e3-8657-7230-8222-3c594b89de6c"))
	(text_box "TX_EN (header 24) high transmits.  U206\nmakes DSOP = not TX_EN; R227 holds TX_EN\nlow, so the modulator is off whenever no\nrunning gateware drives it: the host off,\nunconfigured, or loading another overlay.\nThe gateware's CTRL[0] (TX_DIS) and the\nkeyer drive the header pin inverted." (exclude_from_sim no) (at 193.0400 184.1500 0) (size 40.6400 15.2400)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "236ebd7e-9c85-227c-e7bf-5fce30d4aff9"))
	(text_box "ADL5375-05: 400 MHz-6 GHz quadrature\nmodulator; -4.5 dBm out at 5.8 GHz with\nthis drive, carrier feedthrough -19.5\ndBm.  LO 0 dBm differential from the\nsynthesizer below.  CONSIGNED." (exclude_from_sim no) (at 219.7100 144.7800 0) (size 38.1000 11.4300)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "9b90ee8c-706b-35bb-8675-c7b62b6e58cd"))
	(text_box "5.8 GHz\n(5.15-5.875\nusable) | -4.5\ndBm (379 mV p-p)\n| carrier\nfeedthrough\n-19.5 dBm | no\nDC (1.5 pF)" (exclude_from_sim no) (at 248.9200 102.8700 0) (size 19.0500 16.5100)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
