	(text_box "TX_I1, TX_I0, TX_Q1, TX_Q0: 0 /\n3.3 V CMOS, FAST slew, 1.5 ns edge\n(+4.4 ns through the PYNQ's 200\nohm; none on the Icepi)" (exclude_from_sim no) (at 147.3200 26.6700 0) (size 33.0200 10.1600)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
