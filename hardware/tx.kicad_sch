	(text_box "VR_I / VR_Q: 0.21 V DC\nfrom the DAC (0-0.6\nV): centres the\nladder, nulls the\ncarrier" (exclude_from_sim no) (at 113.0300 66.0400 0) (size 22.8600 11.4300)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
