	(text_box "Pi pad: 0 ohm fitted;\nfit three resistors for\na fixed TX attenuation." (exclude_from_sim no) (at 335.2800 118.1100 0) (size 21.5900 7.6200)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
