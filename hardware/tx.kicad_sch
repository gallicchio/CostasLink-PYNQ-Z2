	(text_box "-20 dB coupled-line coupler,\ncopper on the board (7.3 mm\nbeside the line): TX MON on\nthe coupled end (TX MON: -10.2\ndBm (196 mV p-p) (-20 dB)),\n49.9 ohm on the isolated end" (exclude_from_sim no) (at 373.3800 111.7600 0) (size 30.4800 12.7000)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
