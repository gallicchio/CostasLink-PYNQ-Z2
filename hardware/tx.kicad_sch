	(text_box "ladder node: 0.17 /\n0.50 / 0.83 V DC for\n00 / 01,10 / 11 |\n240 ohm, 3 pF: 1.6\nns | into IBBP (0-1\nV allowed)" (exclude_from_sim no) (at 189.2300 38.1000 0) (size 20.3200 12.7000)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
