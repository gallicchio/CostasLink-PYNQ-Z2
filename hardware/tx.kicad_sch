	(text_box "5.8 GHz (5.15-5.875\nusable) | +9.8 dBm (1964\nmV p-p) (P1dB +13) | DC:\n5 V bias behind 43 nH,\nblocked" (exclude_from_sim no) (at 303.5300 62.2300 0) (size 26.6700 11.4300)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
