	(text_box "PE43711: 0-31.75 dB in 0.25 dB\nsteps, serial mode (P/S high; the\nparallel pins grounded as the\ndatasheet asks).  Powers up at 31.75\ndB." (exclude_from_sim no) (at 77.4700 106.6800 0) (size 34.2900 11.4300)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "a66a5413-d462-6612-0665-095d7f1b4903"))
	(text_box "5.8 GHz (5.15-5.875\nusable) | -48.5 dBm\n(2 mV p-p) with the\nDSA at 5.25 dB (its\nrange: 0 to 31.75\ndB; it holds the\ndemodulator at -20\ndBm from 3 m to\nabout 300 m) | no DC" (exclude_from_sim no) (at 120.6500 71.1200 0) (size 21.5900 17.7800)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
