		(pin "1" (uuid "769ba72a-3ceb-aee6-2b90-1ec574d46ac7"))
		(instances (project "CostasLink-PYNQ-Z2" (path "/24723b42-5fe3-4667-eb46-0acbb937e3f8/6bbffa5f-5c82-d12f-8669-7f065bd8149d" (reference "#PWR") (unit 1)))))
	(label "TEMP" (at 541.0200 355.6000 0) (effects (font (size 1.00 1.00)) (justify right bottom)) (uuid "f20051b9-2c0a-e807-6965-ae5fb14a4ebe"))
	(text_box "The fast arms (sheet 3) decide in 1.8 ns on 100 MHz of bandwidth and read down to -81 dBm; this path takes their\noutputs, multiplies by 20 and filters to 4.8 MHz, so it reads down to -92 dBm (noise-limited: 7.5 MHz of noise, SNR 11.4\ndB for a quiet BPSK decision) and decides 37 ns later.  The gateware acts on the fast flag at once and keeps the trial\nonly if the slow comparators agree: a false alarm costs a trial, not a wrong bit.  The far end must hold a symbol at\nleast 73 ns for this path to see it (BPSK: the flipped phase simply persists).  Offsets: two THS4541s in cascade x20 can\nsit up to 50 mV off; DAC2's I_OFF / Q_OFF null them (watch the slow comparators' duty cycle with no signal)." (exclude_from_sim no) (at 20.3200 24.1300 0) (size 105.4100 12.7000)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "4add176a-318a-073f-c36d-f8869fa21fdc"))
	(text_box "Blue boxes: what is on the wire beside them (frequency | level | bandwidth | DC), computed by sim/budget.py for the 10 m\nbench link with 2 dBi whips (the DSA then at 5.25 dB, holding the demodulator at -20 dBm); the same numbers as\ndocs/images/block_*.svg." (exclude_from_sim no) (at 20.3200 38.1000 0) (size 107.9500 7.6200)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "0407011c-3cb7-23de-fa9b-e5c3d318c6c7"))
	(text_box "I SLOW MON: the slow I\nstage's + output, ahead\nof its 4.8 MHz pole,\nthrough 1k: 1.65 V\n+-1.65 V (x20,\nsaturates), the stage's\nown 40 MHz.  A 50 ohm\nscope here does not move\nthe comparator." (exclude_from_sim no) (at 146.0500 66.0400 0) (size 25.4000 17.7800)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "b192bb6d-0929-f75a-3d2e-0a650ecc0e60"))
	(text_box "I_sP / I_sN, the SLOW arm: x20 after the\nfast arm, then 1000 ohm / 33 pF = 4.8\nMHz (73 ns rise, decides 37 ns after the\nfast one) | saturates at +-1.65 V above\n+-82 mV at the fast arm: the sign\nsurvives | offset up to 50 mV, trimmed\nby I_OFF | reads down to -95 dBm at the\nantenna (noise-quiet -95, floor -107)" (exclude_from_sim no) (at 27.9400 120.6500 0) (size 39.3700 16.5100)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 214 236 255 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "67dc467d-6273-e749-f64b-932abc7e99d3"))
	(text_box "Q SLOW MON: the slow Q\nstage's + output, ahead\nof its pole, through 1k:\n1.65 V, 0 at lock,\nsaturated during a QPSK\nsymbol." (exclude_from_sim no) (at 146.0500 144.7800 0) (size 24.1300 12.7000)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "079b2b31-6a4d-72cb-28d4-e461ecffbc0e"))
	(text_box "Q_sP / Q_sN, the SLOW arm: x20, 4.8 MHz\n| 0 at lock (plus x20 the loop's static\nerror), saturated during a QPSK symbol |\nwindow at V_T2 from DAC2 | offset\ntrimmed by Q_OFF" (exclude_from_sim no) (at 33.0200 196.8500 0) (size 39.3700 11.4300)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 214 236 255 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "64816f45-be68-52c3-5de3-3538f749764f"))
	(text_box "THS4541, the SLOW stage: gain 20 (Rf\n20k / Rg 1k), inputs already at 1.65 V\nso no shunts; noise gain 21: 40 MHz,\nthen the 1k / 33pF pole at 4.8 MHz.\nThe 100 k from the DAC trims the\noffset (sim/budget.py 7b)." (exclude_from_sim no) (at 171.4500 124.4600 0) (size 35.5600 12.7000)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "e3adb0eb-f20b-61cc-59d4-c031b2d54a48"))
	(text_box "CMP_I_S / CMP_QP_S / CMP_QN_S: 0 /\n3.3 V CMOS through 33 ohm | the\nsame decisions 37 ns after the\nfast comparators, 14 dB more\nsensitive | the gateware confirms\nor vetoes the fast flag with them" (exclude_from_sim no) (at 199.3900 68.5800 0) (size 36.8300 12.7000)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 214 236 255 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "92b13000-197e-65e8-1f1b-651ab358cff7"))
	(text_box "DAC2 (MCP4728A1, I2C 0x61), DC\n0-3.3 V: A = V_T2 (the slow Q\nwindow) | B = I_OFF, C = Q_OFF\n(+-0.33 V at the slow outputs\nthrough 100k: null the 50 mV\noffsets by watching the slow\ncomparators' duty cycle) | D =\nI_OFF_F (the FAST I arm's offset\non sheet 3, +-66 mV at its output)" (exclude_from_sim no) (at 336.5500 181.6100 0) (size 33.0200 17.7800)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 214 236 255 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "80cbd7dd-b998-bde4-22e7-56ebc4dc1784"))
	(text_box "MCP4728A1: the same DAC as sheet 3's\nat the factory-preset address 0x61\n(no address programming).  V_T2 sets\nthis path's Q window; I_OFF / Q_OFF\nreach the slow stages' summing nodes\nthrough 100 k; D = I_OFF_F does the\nsame for the FAST I arm on sheet 3\nthrough the 100 k here (its summing\nnode I_SUM comes from that sheet).\nWrite all four EEPROM defaults to\nmid-scale (1.65 V) once, so power-up\ninjects no offset." (exclude_from_sim no) (at 260.3500 236.2200 0) (size 36.8300 22.8600)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "e94edc53-82a3-8f04-036d-dc63de369865"))
	(text_box "AD8310 on the fast Q arm: the link's whole band\n(+-94 MHz round the carrier), 95 dB, 24 mV/dB;\nLOG_Q is a burst's envelope (BFIN 135 kHz; OFLT\n59 kHz).  1k + 1k against its 1000 ohm input:\n0.33 of the arm.  With no carrier and the DSA at\n0 the arm's own noise is 6.8 mV rms, 2.3 mV (-53\ndBV) here, 38 dB over the log amp's floor.  A\nscope on the LOG Q pad shows WiFi's frames." (exclude_from_sim no) (at 54.6100 356.8700 0) (size 46.9900 16.5100)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "40f7d3a9-d5a7-2bca-3277-0f96c0e1c628"))
	(text_box "Peak hold of LOG_Q (Jason: a slowly decaying\npeak for WiFi's bursts beside a truer level).  A\ncharges 10nF through the diode inside its loop\n(no diode drop), B reads it, 4.7M lets it fall\nin 47 ms, so a 20 us frame still reads at the\nADC a few conversions later.  The link's own\nevents lift it too: read it in a pause." (exclude_from_sim no) (at 162.5600 356.8700 0) (size 41.9100 15.2400)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "e4f77f90-3e28-eda4-7cbb-a726da591d8a"))
	(text_box "AIN2: +5V_RF x 0.50.  The ADL53xx and\nthe ADL5611s want 4.75-5.25 V; on a\nroof's long supply lead this says so\nbefore the link does.  (The LTC1968\ntrue-RMS converter drawn here first is a\nrev B option: PLAN.md section 19.)" (exclude_from_sim no) (at 350.5200 360.6800 0) (size 36.8300 12.7000)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "5709cc72-244b-aace-e2f1-bd98079c43ab"))
	(text_box "ADS1115 (I2C 0x49, ADDR to VDD): AIN0\nLOG_Q (its conversion averages the log:\n1.2 ms at 860 SPS, 125 ms at 8 SPS),\nAIN1 PEAK_Q, AIN2 V5_MON (+5V_RF x\n0.50), AIN3 TEMP (a 10 k NTC under 10k\nfrom 3.3 V: 1.65 V at 25 C, 0.77 V at 60\nC).  Each input through 10k / 100nF (159\nHz).  The driver's detectors() reads\nthem; nothing new on the FPGA's header." (exclude_from_sim no) (at 462.2800 360.6800 0) (size 39.3700 17.7800)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "57e7863e-51fa-d91a-7323-b2391bcd449c"))
	(wire (pts (xy 30.4800 88.9000) (xy 41.9100 88.9000)) (stroke (width 0) (type default)) (uuid "a3befeb1-64dc-248b-d828-10c0f99a6633"))
	(wire (pts (xy 49.5300 88.9000) (xy 55.8800 88.9000)) (stroke (width 0) (type default)) (uuid "1a669fe3-ec51-8b8c-9baf-8342befb4600"))
